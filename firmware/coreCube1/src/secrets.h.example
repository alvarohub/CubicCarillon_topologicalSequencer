#pragma once

// Copy this file to secrets.h and set your network.

#define CUBE_WIFI_SSID "YOUR_WIFI_SSID"
#define CUBE_WIFI_PASS "YOUR_WIFI_PASSWORD"

// If STA connection fails, the cube opens this AP for direct connection.
#define CUBE_AP_SSID "CubeLink-CoreS3"
#define CUBE_AP_PASS "cube1234"

// WebSocket server port on CoreS3.
#define CUBE_WS_PORT 8787

